# TM Activation — configuration.
#
# install.sh generates config.yml from this file (kept out of the repo: it holds
# passwords, mode 640). After editing it:
#   sudo systemctl restart tm-activation

site:
  base_url: ""              # public URL, e.g. https://tm.mon-club.fr

server:
  # Reverse proxy (nginx) allowed to pass on the visitor's real IP
  # (X-Forwarded-For) and https (X-Forwarded-Proto): an IP or a CIDR network.
  # These headers are ignored from any other address, so a client cannot
  # pretend to be on the local network or get around the password
  # brute-force blocking. Nginx on another machine: put its IP here.
  trusted_proxies: ["127.0.0.1", "::1"]

auth:
  # ADMINISTRATOR password: Settings (special callsigns, operator password,
  # scoring rule, backups). Log in at /login.
  # Empty = administration disabled.
  password: ""

club:
  # Radio club activating the callsigns: shown in the header, the footer
  # and the public /activations list. Everything is optional.
  callsign: ""              # e.g. F6ABC
  name: ""                  # e.g. Radio-club de Villeneuve
  city: ""                  # e.g. Villeneuve
  website: ""               # e.g. https://www.mon-club.fr

qrz:
  # Optional — QRZ.com account with an XML subscription: name, locator and country
  # of worked stations (log entry, map, DXCC table, distance points).
  # Simpler: Settings → QRZ Callbook (takes precedence, no restart needed).
  username: ""
  password: ""
  ttl_seconds: 21600        # in-memory lookup cache (6 h)

activation:
  # First special callsign, created on the FIRST start only. After that
  # everything is set in the interface (Settings → Special callsigns), including
  # creating further callsigns.
  callsign: "TM0ABC"
  label: ""                 # e.g. 50 ans du radio-club
  my_gridsquare: ""         # station locator (4, 6 or 8 chars): ADIF + distances
  public: false             # public /<callsign> page online from the start
  # Shared operator password (log in at /activation/login with
  # their callsign). Can be changed later in Settings, which take precedence.
  password: ""
  operators: []             # initial list of operators, e.g. ["F1ABC", "F4XYZ"]
  qrz_enrich: true          # fill in QRZ records in the background
  qrz_interval_seconds: 10  # 1 callsign every N seconds
