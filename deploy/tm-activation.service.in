[Unit]
Description=TM Activation (@SERVICE@) - indicatifs speciaux radioamateur
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
Environment=TM_CONFIG=@DIR@/config.yml
Environment=PYTHONDONTWRITEBYTECODE=1
# A single worker (in-memory blocking + QRZ background task). The proxy
# headers are handled by the application according to server.trusted_proxies.
ExecStart=@DIR@/.venv/bin/uvicorn app.main:app --host @HOST@ --port @PORT@ --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=3

# Hardening: only var/ (database, backups, secret) is writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@DIR@/var
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Port < 1024 (80 on the local network): the only capability granted; else none.
AmbientCapabilities=@CAPS@
CapabilityBoundingSet=@CAPS@

[Install]
WantedBy=multi-user.target
