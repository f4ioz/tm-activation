# Nginx reverse proxy for TM Activation.
#
# `sudo ./install.sh --domain …` generates this file by itself (domain and
# .local name filled in): nothing to do by hand in that case.
#
# Manual use (--manual mode):
#   sudo cp nginx.conf.example /etc/nginx/sites-available/tm-activation
#   (adjust both server_name and proxy_pass)
#   sudo ln -s /etc/nginx/sites-available/tm-activation /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d tm.mon-club.fr     # Let's Encrypt HTTPS + redirect 80 → 443
#
# Nginx on a DIFFERENT machine from the application: install with
#   --host 0.0.0.0   and put nginx's IP in server.trusted_proxies (config.yml).

# Public access: https://tm.mon-club.fr (certbot adds the HTTPS block).
server {
    listen 80;
    listen [::]:80;
    server_name tm.mon-club.fr;

    client_max_body_size 10m;          # ADIF file import

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $remote_addr (not $proxy_add_x_forwarded_for): the IP passed on
        # is the one nginx sees, never a value supplied by the client.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Access from the local network: http://machine-name.local. Required when
# the router does not loop the public address back inside (no "NAT loopback"
# support): on-site operators come in here. Refused from the Internet.
server {
    listen 80;
    listen [::]:80;
    server_name nom-machine.local;

    allow 127.0.0.0/8;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow ::1;
    allow fc00::/7;
    allow fe80::/10;
    deny all;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
